<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>apply.done.headline</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Moved %#@n@, freeing %2$@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>1 file</string>
			<key>other</key>
			<string>%1$d files</string>
		</dict>
	</dict>
	<key>apply.headline</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@ would move to the Trash, freeing %2$@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>1 file</string>
			<key>other</key>
			<string>%1$d files</string>
		</dict>
	</dict>
	<key>folders.apply.headline</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@ would move to the Trash</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>1 folder</string>
			<key>other</key>
			<string>%1$d folders</string>
		</dict>
	</dict>
	<key>folders.warnLoss</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>Moving %2$@ would lose 1 file it has and the other does not.</string>
			<key>other</key>
			<string>Moving %2$@ would lose %1$d files it has and the other does not.</string>
		</dict>
	</dict>
	<key>undo.alreadyRestored</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@, byte for byte — Finder's own Put Back does the same.</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>1 was already back</string>
			<key>other</key>
			<string>%d were already back</string>
		</dict>
	</dict>
	<key>undo.failed</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@.</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>1 could not be put back</string>
			<key>other</key>
			<string>%d could not be put back</string>
		</dict>
	</dict>
</dict>
</plist>
