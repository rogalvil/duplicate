<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>apply.done.failed</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@.</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>1 archivo se dejó en paz</string>
			<key>other</key>
			<string>%d archivos se dejaron en paz</string>
		</dict>
	</dict>
	<key>apply.done.headline</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@, liberando %2$@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>Se movió 1 archivo</string>
			<key>other</key>
			<string>Se movieron %1$d archivos</string>
		</dict>
	</dict>
	<key>apply.headline</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@ al basurero, liberando %2$@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>Se movería 1 archivo</string>
			<key>other</key>
			<string>Se moverían %1$d archivos</string>
		</dict>
	</dict>
	<key>folders.apply.collapsed</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@.</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>1 ya está dentro de una carpeta de esta lista</string>
			<key>other</key>
			<string>%d ya están dentro de una carpeta de esta lista</string>
		</dict>
	</dict>
	<key>folders.apply.headline</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>1 carpeta iría al basurero</string>
			<key>other</key>
			<string>%1$d carpetas irían al basurero</string>
		</dict>
	</dict>
	<key>folders.warnLoss</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>Mover %2$@ perdería 1 archivo que tiene y la otra no.</string>
			<key>other</key>
			<string>Mover %2$@ perdería %1$d archivos que tiene y la otra no.</string>
		</dict>
	</dict>
	<key>sessions.prune.body.kept</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>1 sesión todavía tiene archivos que nunca se restauraron y se deja en paz.</string>
			<key>other</key>
			<string>%d sesiones todavía tienen archivos que nunca se restauraron y se dejan en paz.</string>
		</dict>
	</dict>
	<key>sessions.prune.body.prunable</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>1 sesión tiene todos sus archivos de vuelta, así que su journal ya no ofrece nada. Borrarlo libera %2$@.</string>
			<key>other</key>
			<string>%1$d sesiones tienen todos sus archivos de vuelta, así que sus journals ya no ofrecen nada. Borrarlos libera %2$@.</string>
		</dict>
	</dict>
	<key>sessions.prune.nothing.kept</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>1 sesión todavía tiene archivos que se podrían restaurar, y su journal es el único registro de dónde quedaron.</string>
			<key>other</key>
			<string>%d sesiones todavía tienen archivos que se podrían restaurar, y sus journals son el único registro de dónde quedaron.</string>
		</dict>
	</dict>
	<key>similar.ambiguousKey.body</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@ El CLI leería esas claves como otro par, así que revísalos antes de correr un movimiento: %2$@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>1 de los pares que decidiste trae "||" en una ruta, que es el separador de este formato.</string>
			<key>other</key>
			<string>%1$d de los pares que decidiste traen "||" en una ruta, que es el separador de este formato.</string>
		</dict>
	</dict>
	<key>undo.alreadyRestored</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@, byte por byte — el "Sacar del basurero" de Finder hace lo mismo.</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>1 ya estaba de vuelta</string>
			<key>other</key>
			<string>%d ya estaban de vuelta</string>
		</dict>
	</dict>
	<key>undo.failed</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@.</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>1 no se pudo devolver</string>
			<key>other</key>
			<string>%d no se pudieron devolver</string>
		</dict>
	</dict>
</dict>
</plist>
